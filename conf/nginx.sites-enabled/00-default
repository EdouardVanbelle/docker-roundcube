server {

        listen 80 default_server;
        server_name localhost;

        set_real_ip_from  172.0.0.0/8;
        real_ip_header    X-Forwarded-For;
        real_ip_recursive on;

        access_log /data/log/roundcube/mail.vanbelle.fr.access.log;
        error_log  /data/log/roundcube/mail.vanbelle.fr.error.log;

        # tell browser to continue only in HTTPS
        #add_header Strict-Transport-Security "max-age=31536000";

        client_max_body_size 40M;

        root /home/roundcube/public_html;
        index index.php index.html index.htm;

        location / {
                #try_files $uri $uri/ /index.php?q=$uri&$args;
                try_files $uri /index.php$is_args$args;
        }

        location ~ ^/(README.md|INSTALL|LICENSE|CHANGELOG|UPGRADING)$ {
                deny all;
        }

        location ~ ^/(config|temp|logs)/ {
                deny all;
        }

        location ~ \.php(/|$) {
                include snippets/fastcgi-php.conf;

                fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
                #try_files $uri =404;
                #fastcgi_split_path_info ^(.+\.php)(/.*)$;
                #fastcgi_index index.php;
                #include fastcgi_params;
                #fastcgi_param SCRIPT_FILENAME $document_root/$fastcgi_script_name;
                #fastcgi_param PATH_INFO         $fastcgi_path_info;
                #fastcgi_param REDIRECT_SCRIPT_URL $http_x_forwarded_prefix$request_uri;
        }
}
